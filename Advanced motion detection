def cv2_to_pygame(frame):
    """Convert OpenCV frame to PyGame surface"""
    # Convert BGR to RGB
    frame_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    # Rotate and flip if needed (depends on your camera)
    frame_rgb = np.rot90(frame_rgb)
    frame_rgb = pygame.surfarray.make_surface(frame_rgb)
    return frame_rgb

def detect_motion(frame):
    """Detect motion in the frame with enhanced features"""
    global prev_frame, motion_detected, motion_counter, sensitivity
    
    # Convert to grayscale and blur
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    gray = cv2.GaussianBlur(gray, (21, 21), 0)
    
    if prev_frame is None:
        prev_frame = gray
        return False, None, []
    
    # Compute absolute difference between current and previous frame
    frame_delta = cv2.absdiff(prev_frame, gray)
    thresh = cv2.threshold(frame_delta, 25, 255, cv2.THRESH_BINARY)[1]
    
    # Dilate the thresholded image to fill in holes
    thresh = cv2.dilate(thresh, None, iterations=2)
    
    # Find contours on thresholded image
    contours, _ = cv2.findContours(thresh.copy(), cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    
    motion_detected = False
    motion_frame = frame.copy()
    motion_regions = []
    
    for contour in contours:
        if cv2.contourArea(contour) < sensitivity:
            continue
            
        motion_detected = True
        (x, y, w, h) = cv2.boundingRect(contour)
        motion_regions.append((x, y, w, h))
        
        # Draw rectangle around moving object
        cv2.rectangle(motion_frame, (x, y), (x + w, y + h), (0, 255, 0), 2)
        
        # Draw center point
        center_x, center_y = x + w//2, y + h//2
        cv2.circle(motion_frame, (center_x, center_y), 5, (255, 0, 0), -1)
        
        # Add motion intensity text
        area = cv2.contourArea(contour)
        intensity = min(100, int(area / 50))
        cv2.putText(motion_frame, f"{intensity}%", (x, y-10), 
                   cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)
    
    prev_frame = gray
    
    # Update motion counter with persistence
    if motion_detected:
        motion_counter += 1
    else:
        motion_counter = max(0, motion_counter - 1)
    
    return motion_detected or motion_counter > 5, motion_frame, motion_regions

def save_snapshot(frame):
    """Save current frame as image with timestamp"""
    timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    filename = f"motion_captures/snapshot_{timestamp}.jpg"
    cv2.imwrite(filename, frame)
    print(f"📸 Snapshot saved: {filename}")
    return filename

def start_recording():
    """Start recording video"""
    global recording, video_writer
    timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    filename = f"motion_videos/recording_{timestamp}.avi"
    fourcc = cv2.VideoWriter_fourcc(*'XVID')
    video_writer = cv2.VideoWriter(filename, fourcc, 20.0, (WIDTH, HEIGHT))
    recording = True
    print(f"🎥 Recording started: {filename}")
    return filename

def stop_recording():
    """Stop recording video"""
    global recording, video_writer
    if video_writer:
        video_writer.release()
        video_writer = None
    recording = False
    print("⏹️ Recording stopped")

